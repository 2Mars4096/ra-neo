+++ b/tests/zz_aed_probe_tall.gd
@@ -0,0 +1,38 @@
+extends SceneTree
+const Visuals=preload("res://scripts/visuals.gd")
+const Library=preload("res://scripts/asset_library.gd")
+const City=preload("res://scripts/city_buildings.gd")
+func walk(node:Node,t:Transform3D,box:Array)->void:
+	var x:Transform3D=t*(node.transform if node is Node3D else Transform3D.IDENTITY)
+	if node is MeshInstance3D and node.mesh!=null:
+		var a:AABB=x*node.mesh.get_aabb()
+		box[0]=a if box[0]==null else box[0].merge(a)
+	for c in node.get_children():walk(c,x,box)
+func _init()->void:call_deferred("run")
+func run()->void:
+	var config:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://resources/scenarios.json"))[6]
+	var art=Visuals.new()
+	var stage:=Node3D.new();root.add_child(stage)
+	var seen:={}
+	for p in config.map_props:
+		if seen.has(p.id):continue
+		seen[p.id]=true
+		var m:Node3D=Library.build(art,stage,p.id)
+		var box:=[null];walk(m,Transform3D.IDENTITY,box)
+		var spec:=Library.find(p.id)
+		var a:AABB=box[0]
+		print("PROP ",p.id," top=",snappedf(a.end.y,0.01)," reg=",spec.height," render_xz=",Rect2(a.position.x,a.position.z,a.size.x,a.size.z)," fp=",spec.footprint, " BAD" if a.end.y>float(spec.height)+0.01 else "")
+		m.free()
+	var worst:={}
+	for i in config.architecture.size():
+		var spec:Dictionary=config.architecture[i]
+		var size:=Vector2(spec.source_size[0],spec.source_size[1]);var c:=Vector2(spec.position[0],spec.position[1])
+		var b:Node3D=art.make_authored_building(stage,Rect2(c-size/2,size),i,spec)
+		var box:=[null];walk(b,Transform3D.IDENTITY,box)
+		var a:AABB=box[0]
+		var cap:float=City.height_cap(spec.design,int(spec.get("floors",1))) if City.handles(spec.design) else -1.0
+		var key:String=spec.design+"/"+str(spec.get("floors",1))
+		if not worst.has(key) or worst[key][0]<a.end.y:worst[key]=[snappedf(a.end.y,0.01),cap,a.position.x,a.end.x,a.position.z,a.end.z,c]
+		b.free()
+	for k in worst:print("BLD ",k," ",worst[k])
+	quit()
