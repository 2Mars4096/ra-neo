diff --git a/tests/zz_aed_probe_road.gd b/tests/zz_aed_probe_road.gd
new file mode 100644
index 0000000..08b26d0
--- /dev/null
+++ b/tests/zz_aed_probe_road.gd
@@ -0,0 +1,32 @@
+extends SceneTree
+const Terrain=preload("res://scripts/terrain.gd")
+func _init()->void:call_deferred("run")
+func first_bad(terrain,origin:Vector2,route:Array,radius:float):
+	if route.is_empty():return "EMPTY"
+	for point in route:
+		var count:=maxi(1,ceili(origin.distance_to(point)/0.05))
+		for step in range(count+1):
+			var q:Vector2=origin.lerp(point,float(step)/count)
+			if not terrain.traversable(q,"land",radius):return [q,origin,point]
+		origin=point
+	return null
+func run()->void:
+	for scenario in [3,4]:
+		var terrain=Terrain.new(scenario)
+		var baseline=Terrain.new(scenario);baseline.roadside_blocks.clear()
+		for edge in terrain.roads.segments:
+			for radius in [0.8,2.45,2.65]:
+				if not baseline.path(edge.a,edge.b,"land",radius).is_empty():
+					var route=terrain.path(edge.a,edge.b,"land",radius)
+					var bad=first_bad(terrain,edge.a,route,radius)
+					if bad!=null:print("ROUTE s=",scenario," ",edge.purpose," ",edge.a,"->",edge.b," r=",radius," bad=",bad," route=",route)
+		for building in terrain.blocks:
+			for side in [-1.0,1.0]:
+				var approach:Vector2=building.get_center()+Vector2(0,side*(building.size.y/2+3.5))
+				for radius in [0.8,2.65]:
+					var origin:=Vector2(40,26.5) if scenario==3 else Vector2(40,60)
+					if not baseline.path(origin,approach,"land",radius).is_empty():
+						var route=terrain.path(origin,approach,"land",radius)
+						var bad=first_bad(terrain,origin,route,radius)
+						if bad!=null:print("APPROACH s=",scenario," ",approach," r=",radius," bad=",bad," route=",route)
+	quit()
diff --git a/tests/zz_aed_probe_tall.gd b/tests/zz_aed_probe_tall.gd
