; RA Neo — Godot 4.5.1
config_version=5

[application]
config/name="RA NEO — Coastal Spear"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="A tactical combined-arms RTS prototype."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=1280
window/size/min_height=800

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.055, 0.085, 0.105, 1)

[physics]
common/physics_ticks_per_second=30
